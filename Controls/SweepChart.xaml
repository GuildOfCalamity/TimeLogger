<UserControl
    x:Class="TimeLogger.Controls.SweepChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TimeLogger.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="250"
    d:DesignWidth="400"
    Background="Transparent"
    mc:Ignorable="d">
    <Grid x:Name="PART_Grid" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <!--  Tooltip  -->
        <Border
            x:Name="PART_Tooltip"
            Padding="10,4"
            Background="#88000000"
            BorderBrush="#881E90FF"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="Collapsed">
            <TextBlock
                x:Name="PART_TooltipText"
                Background="Transparent"
                FontSize="14"
                Foreground="White"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="6"
                    Opacity="0.7"
                    ShadowDepth="8"
                    Color="Black" />
            </Border.Effect>
        </Border>
    </Grid>
</UserControl>
