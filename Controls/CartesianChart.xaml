<UserControl
    x:Class="TimeLogger.Controls.CartesianChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TimeLogger.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="250"
    d:DesignWidth="450"
    mc:Ignorable="d">
    <Grid>
        <Canvas
            x:Name="PART_Canvas"
            Background="Transparent"
            ClipToBounds="False">

            <Canvas x:Name="PART_PointLayer" />

            <!--  Highlight  -->
            <Ellipse
                x:Name="PART_HighlightDot"
                Width="14"
                Height="14"
                Fill="DeepSkyBlue"
                Stroke="White"
                StrokeThickness="1"
                Visibility="Collapsed" />
            <!--  Tooltip  -->
            <Border
                x:Name="PART_Tooltip"
                Padding="10,4"
                Background="#88000000"
                BorderBrush="#881E90FF"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="PART_TooltipText"
                    Background="Transparent"
                    FontSize="14"
                    Foreground="White" />
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="6"
                        Opacity="0.7"
                        ShadowDepth="8"
                        Color="Black" />
                </Border.Effect>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
