<Window
    x:Class="TimeLogger.WpfMessageBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TimeLogger"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:support="clr-namespace:TimeLogger.Support"
    Title="Message"
    Width="490"
    Height="250"
    support:DarkTitleBar.ApplyDarkMode="True"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">
    <Border
        Margin="6"
        Background="#151515"
        BorderBrush="DodgerBlue"
        BorderThickness="1"
        CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="10"
                Opacity="0.4"
                ShadowDepth="4"
                Color="#000000" />
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image
                x:Name="imgOk"
                Grid.Row="0"
                Width="48"
                Height="48"
                Margin="-10"
                HorizontalAlignment="Left"
                Opacity="0.9"
                RenderOptions.BitmapScalingMode="Fant"
                Source="/Logo_Normal.png"
                Visibility="Visible" />
            <Image
                x:Name="imgErr"
                Grid.Row="0"
                Width="48"
                Height="48"
                Margin="-10"
                HorizontalAlignment="Left"
                Opacity="0.9"
                RenderOptions.BitmapScalingMode="Fant"
                Source="/Logo_Warn.png"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="MessageText"
                Grid.Row="1"
                Margin="8,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="18"
                Foreground="White"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="Message Here"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="2"
                Margin="0,10,0,-1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="btnOK"
                    Width="90"
                    Height="34"
                    Click="Ok_Click"
                    Content="OK"
                    IsDefault="True" />
                <Button
                    x:Name="btnCancel"
                    Width="90"
                    Height="34"
                    Margin="6,0,0,0"
                    Click="Cancel_Click"
                    Content="Cancel"
                    IsDefault="False" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
