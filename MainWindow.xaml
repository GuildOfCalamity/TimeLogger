<Window
    x:Class="TimeLogger.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:TimeLogger.Behaviors"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:TimeLogger"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TimeLogger"
    Width="1000"
    Height="750"
    Background="#181818"
    FontFamily="Aptos Mono"
    Icon="/AppIcon.ico"
    WindowStartupLocation="CenterScreen">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard x:Name="storyboard" Timeline.DesiredFrameRate="60">
                    <DoubleAnimation
                        Storyboard.TargetName="root"
                        Storyboard.TargetProperty="Opacity"
                        From="0"
                        To="1"
                        Duration="0:0:0.5" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!--  [Global] pressing Enter will add a new entry  -->
    <!--<Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding AddEntryCommand}" />
    </Window.InputBindings>-->

    <Grid x:Name="root">
        <Grid.RowDefinitions>
            <!--  Input Pane  -->
            <RowDefinition Height="Auto" />
            <!--  Totals Pane  -->
            <RowDefinition Height="Auto" />
            <!--  Entries List  -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  USER INPUT  -->
        <Border
            Grid.Row="0"
            Padding="10"
            Background="#222">
            <StackPanel Orientation="Vertical">
                <Label
                    Content="Task Description"
                    FontSize="16"
                    Foreground="{StaticResource BlueBrushLinear}" />
                <TextBox x:Name="description" Text="{Binding DescriptionInput, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddEntryCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Label
                    Content="Work Item URL"
                    FontSize="16"
                    Foreground="{StaticResource BlueBrushLinear}" />

                <TextBox Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddEntryCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Label
                    Content="Time (e.g., 1d 2h 30m)"
                    FontSize="16"
                    Foreground="{StaticResource BlueBrushLinear}" />
                <TextBox Text="{Binding TimeInput, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddEntryCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Height="36"
                        Margin="0,8,0,0"
                        Command="{Binding AddEntryCommand}"
                        Content="Add Entry" />
                    <DatePicker
                        Grid.Column="1"
                        CalendarStyle="{StaticResource DarkCalendar}"
                        SelectedDate="{Binding NewEntryDate, Mode=TwoWay}"
                        SelectedDateFormat="Short" />
                </Grid>
            </StackPanel>
        </Border>

        <!--  CURRENT TOTALS  -->
        <Border
            Grid.Row="1"
            Padding="10"
            Background="#111">
            <StackPanel Orientation="Vertical">

                <TextBlock
                    FontSize="18"
                    Foreground="White"
                    Text="Today's Total:" />
                <TextBlock
                    FontSize="24"
                    Foreground="#4CAF50"
                    Text="{Binding TodayTotalDisplay}" />

                <Separator />

                <TextBlock
                    FontSize="18"
                    Foreground="White"
                    Text="This Week's Total:" />
                <TextBlock
                    FontSize="24"
                    Foreground="#03A9F4"
                    Text="{Binding WeekTotalDisplay}" />

            </StackPanel>
        </Border>

        <!--  LIST ENTRIES  -->
        <Border
            Grid.Row="2"
            Padding="4"
            Background="#1A1A1A">
            <ListBox
                Margin="0"
                Background="#252525"
                BorderBrush="#333"
                BorderThickness="1"
                Foreground="White"
                ItemsSource="{Binding Entries}"
                SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">

                <!--<i:Interaction.Behaviors>
                    <behaviors:DragReorderBehavior />
                </i:Interaction.Behaviors>-->

                <!--#region [Swipe Item Template using code-behind]-->
                <!--
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="SwipeItem_PreviewMouseLeftButtonDown" />
                        <EventSetter Event="PreviewMouseMove" Handler="SwipeItem_PreviewMouseMove" />
                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="SwipeItem_PreviewMouseLeftButtonUp" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="70" Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="480" />
                                <ColumnDefinition Width="480" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Background="#2962FF"
                                CornerRadius="6"
                                IsHitTestVisible="False">
                                <TextBlock
                                    Margin="20"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="24"
                                    Foreground="White"
                                    Opacity="0.85"
                                    Text="✏️" />
                            </Border>
                            <Border
                                Grid.Column="1"
                                Background="#B00020"
                                CornerRadius="6"
                                IsHitTestVisible="False">
                                <TextBlock
                                    Margin="20"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="26"
                                    Foreground="White"
                                    Opacity="0.85"
                                    Text="🗑" />
                            </Border>
                            <Border
                                x:Name="SwipeContent"
                                Grid.ColumnSpan="2"
                                Padding="10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="#2D2D2D"
                                CornerRadius="6"
                                IsHitTestVisible="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="{Binding Description}" />
                                        <TextBlock
                                            Cursor="Hand"
                                            Foreground="#7FAAFF"
                                            Text="{Binding Url}"
                                            TextDecorations="Underline" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Foreground="#4CAF50"
                                            Text="{Binding TimeSpent}" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            FontSize="12"
                                            Foreground="#888"
                                            Text="{Binding Date}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Width="80"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Stretch"
                                        Panel.ZIndex="10"
                                        Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Content="Edit" />
                                </Grid>
                            </Border>

                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                -->
                <!--#endregion-->

                <!--  DoubleClick Editing  -->
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding DataContext.DoubleClickCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>

                <!--#region [Swipe Item Template using DP behavior]-->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Background="#2962FF"
                                CornerRadius="4"
                                IsHitTestVisible="False">
                                <Grid>
                                    <TextBlock
                                        Margin="20"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="24"
                                        Foreground="White"
                                        Opacity="0.85"
                                        Text="✏️" />
                                </Grid>
                            </Border>
                            <Border
                                Grid.Column="2"
                                Background="#B00020"
                                CornerRadius="4"
                                IsHitTestVisible="False">
                                <Grid>
                                    <TextBlock
                                        Margin="20"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="26"
                                        Foreground="White"
                                        Opacity="0.85"
                                        Text="🗑" />
                                </Grid>
                            </Border>
                            <!-- [If using home-brew behavior class]
                            <Border
                                x:Name="SwipeContent"
                                Grid.ColumnSpan="3"
                                Margin="0"
                                Padding="10"
                                behaviors:SwipeToDeleteOrEditBehavior.DeleteCommand="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                behaviors:SwipeToDeleteOrEditBehavior.EditCommand="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                behaviors:SwipeToDeleteOrEditBehavior.EnableSwipe="True"
                                Background="#2D2D2D"
                                CornerRadius="4"
                                Focusable="False"
                                IsHitTestVisible="True">
                            -->
                            <Border
                                x:Name="SwipeContent"
                                Grid.ColumnSpan="3"
                                Margin="0"
                                Padding="10"
                                Background="#2D2D2D"
                                CornerRadius="4"
                                Focusable="False"
                                IsHitTestVisible="True">
                                <i:Interaction.Behaviors>
                                    <behaviors:SwipeBehavior DeleteCommand="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" EditCommand="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                </i:Interaction.Behaviors>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="{Binding Description}" />
                                        <TextBlock
                                            Cursor="Hand"
                                            Foreground="#7FAAFF"
                                            Text="{Binding Url}"
                                            TextDecorations="Underline">
                                            <i:Interaction.Behaviors>
                                                <behaviors:ClickToOpenUrlBehavior />
                                            </i:Interaction.Behaviors>
                                        </TextBlock>
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Foreground="#4CAF50"
                                            Text="{Binding TimeSpent}" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            FontSize="12"
                                            Foreground="#888"
                                            Text="{Binding Date}" />
                                    </StackPanel>
                                    <!--
                                    <Button
                                        Width="80"
                                        HorizontalAlignment="Right"
                                        Focusable="True"
                                        VerticalAlignment="Stretch"
                                        Panel.ZIndex="99"
                                        Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Content="Edit" />
                                    -->
                                    <StackPanel
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        Opacity="0.8"
                                        Orientation="Horizontal">
                                        <Border
                                            Width="100"
                                            Height="30"
                                            Margin="0,0,10,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Stretch"
                                            Background="Transparent"
                                            BorderBrush="{StaticResource BlueBrushLinear}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Focusable="False">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource BlueBrushLinear}"
                                                Text="❮❮❮❮ Delete" />
                                        </Border>
                                        <Border
                                            Width="100"
                                            Height="30"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Stretch"
                                            Background="Transparent"
                                            BorderBrush="{StaticResource BlueBrushLinear}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Focusable="False">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource BlueBrushLinear}"
                                                Text="Edit ❯❯❯❯" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <!--#endregion-->

            </ListBox>
        </Border>

    </Grid>

</Window>
