<Window
    x:Class="TimeLogger.EditEntryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TimeLogger"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Edit Entry"
    Width="500"
    Height="380"
    Background="#222"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard x:Name="storyboard" Timeline.DesiredFrameRate="60">
                    <DoubleAnimation
                        Storyboard.TargetName="root"
                        Storyboard.TargetProperty="Opacity"
                        From="0"
                        To="1"
                        Duration="0:0:0.5" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="root" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard Timeline.DesiredFrameRate="60">
                        <ThicknessAnimation
                            Storyboard.TargetProperty="Margin"
                            From="0,-200,0,0"
                            To="15"
                            Duration="0:0:0.4" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <StackPanel Grid.Row="0" Orientation="Vertical">
            <Label
                Content="Task Description"
                FontSize="16"
                Foreground="{StaticResource BlueBrushLinear}" />
            <TextBox Margin="0,0,0,10" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Vertical">
            <Label
                Content="Work Item URL"
                FontSize="16"
                Foreground="{StaticResource BlueBrushLinear}" />
            <TextBox Margin="0,0,0,10" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Vertical">
            <Label
                Content="Time (e.g., 1d 2h 30m)"
                FontSize="16"
                Foreground="{StaticResource BlueBrushLinear}" />
            <TextBox Margin="0,0,0,10" Text="{Binding TimeInput, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </StackPanel>

        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">
            <Button
                Width="100"
                Margin="0,0,10,0"
                Command="{Binding SaveCommand}"
                Content="Save" />
            <Button
                Width="100"
                Command="{Binding CancelCommand}"
                Content="Cancel" />
        </StackPanel>
    </Grid>

</Window>
