                                    <Calendar x:Name="PART_Calendar" BorderThickness="0" />
                                </Border>
                            </Popup>-->
                        <!--#endregion-->

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>