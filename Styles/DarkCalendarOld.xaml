<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TimeLogger.Controls"
    xmlns:local="clr-namespace:TimeLogger"
    xmlns:o="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- [EXAMPLE USAGE]
    <DatePicker
       CalendarStyle="{StaticResource DarkCalendar}"
       SelectedDate="{Binding NewEntryDate, Mode=TwoWay}"
       SelectedDateFormat="Short" />
    -->

    <Style x:Key="DarkCalendarItem" TargetType="primitives:CalendarItem">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:CalendarItem">
                    <Grid Background="#101010">
                        <Grid.Resources>
                            <!--  DAY BUTTONS  -->
                            <Style TargetType="primitives:CalendarDayButton">
                                <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=primitives:CalendarItem}}" />
                                <Setter Property="Foreground" Value="#F0F0F0" />
                                <Setter Property="Background" Value="#101010" />
                                <Setter Property="BorderBrush" Value="#333333" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="primitives:CalendarDayButton">
                                            <Border
                                                x:Name="Root"
                                                Padding="6"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#2A2A2A" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#2962FF" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                                <Trigger Property="IsToday" Value="True">
                                                    <Setter TargetName="Root" Property="BorderBrush" Value="#4FC3F7" />
                                                    <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!--  MONTH/YEAR HEADER BUTTONS  -->
                            <Style TargetType="primitives:CalendarButton">
                                <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=primitives:CalendarItem}}" />
                                <Setter Property="Foreground" Value="#F0F0F0" />
                                <Setter Property="Background" Value="#101010" />
                                <Setter Property="BorderBrush" Value="#333333" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="primitives:CalendarButton">
                                            <Border
                                                x:Name="Root"
                                                Padding="6"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#2A2A2A" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#2962FF" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                        </Grid.Resources>
                        <!--  Use default CalendarItem layout  -->
                        <CalendarItem />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkDatePickerTextBox" TargetType="{x:Type DatePickerTextBox}">
        <Setter Property="Foreground" Value="#F0F0F0" />
        <Setter Property="Background" Value="#2D2D2D" />
        <Setter Property="BorderBrush" Value="#444444" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--  DARK CALENDAR  -->
    <Style x:Key="DarkCalendar" TargetType="{x:Type Calendar}">
        <Setter Property="Background" Value="#2D2D2D" />
        <Setter Property="Foreground" Value="#F0F0F0" />
        <Setter Property="BorderBrush" Value="#555555" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <Grid>
                        <!--<primitives:CalendarItem
                                x:Name="PART_CalendarItem"
                                BorderBrush="{StaticResource BlueBrushLinear}"
                                BorderThickness="2" />-->
                        <Border
                            Margin="1"
                            BorderBrush="{StaticResource BlueBrushLinear}"
                            BorderThickness="4"
                            CornerRadius="4">
                            <CalendarItem
                                x:Name="PART_CalendarItem"
                                Margin="-1"
                                Padding="0"
                                Background="#040404"
                                FontSize="18"
                                Foreground="#F0F0F0" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--  DARK CALENDAR DAY BUTTON  -->
    <Style x:Key="DarkCalendarDayButton" TargetType="{x:Type CalendarDayButton}">
        <Setter Property="Foreground" Value="#F0F0F0" />
        <Setter Property="Background" Value="#2D2D2D" />
        <Setter Property="BorderBrush" Value="#444444" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border
                        x:Name="Root"
                        Padding="4"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  Hover  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#3A3A3A" />
                        </Trigger>
                        <!--  Selected  -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#2962FF" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <!--  Today  -->
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="#4FC3F7" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--  DARK DATEPICKER  -->
    <Style TargetType="{x:Type DatePicker}">
        <Setter Property="Foreground" Value="#F0F0F0" />
        <Setter Property="Background" Value="#2D2D2D" />
        <Setter Property="BorderBrush" Value="#444444" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <!--  TEXTBOX  -->
                        <DatePickerTextBox
                            x:Name="PART_TextBox"
                            Grid.Column="0"
                            Margin="2,8,0,0"
                            Padding="4"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center"
                            Background="#2D2D2D"
                            BorderBrush="#444444"
                            BorderThickness="0"
                            FontSize="16"
                            Foreground="{StaticResource BlueBrushLinear}"
                            Style="{StaticResource DarkDatePickerTextBox}" />
                        <!--  BUTTON  -->
                        <Button
                            x:Name="PART_Button"
                            Grid.Column="1"
                            Margin="1,8,0,0"
                            Padding="0"
                            Background="#3A3A3A"
                            BorderBrush="#555555"
                            BorderThickness="0"
                            Cursor="Hand">
                            <Path
                                Width="12"
                                Height="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M0,0 L1,0 0.5,1 Z"
                                Fill="#F0F0F0"
                                Stretch="Uniform" />
                        </Button>

                        <!--#region [SIMPLE POPUP]-->
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Placement="Left"
                            StaysOpen="False">
                            <Border
                                Padding="4"
                                Background="#2D2D2D"
                                BorderBrush="#555555"
                                BorderThickness="0"
                                CornerRadius="6">
                                <Calendar
                                    x:Name="PART_Calendar"
                                    BorderThickness="0"
                                    CalendarDayButtonStyle="{StaticResource DarkCalendarDayButton}"
                                    FontSize="18"
                                    Style="{StaticResource DarkCalendar}" />
                            </Border>
                        </Popup>
                        <!--#endregion-->

